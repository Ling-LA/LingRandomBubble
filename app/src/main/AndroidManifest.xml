<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.tencent.mobileqq" /></queries>
    <!-- No INTERNET, storage, accessibility, overlay, or root permissions. -->
    <application android:allowBackup="false" android:label="Ling 随机气泡"
        android:icon="@android:drawable/ic_dialog_email"
        android:theme="@style/AppTheme" android:supportsRtl="true">
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Every IPC method checks Binder UID. Only QQ and this app can use it. -->
        <provider android:name=".store.ConfigProvider"
            android:authorities="io.github.ling.randombubble.config"
            android:exported="true" android:grantUriPermissions="false" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="实验版：独立随机气泡，严格避开 QFun 复读。目标 QQ 9.3.50。" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
